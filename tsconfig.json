{
  "compilerOptions": {
    "target": "ES2022",
    "module": "none",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "assets/ts",
    "strict": true,
    "skipLibCheck": true,
    "removeComments": true,
    "sourceMap": false,
    "newLine": "lf"
  },
  "include": ["src/**/*.ts"]
}
